{
  "name": "eslint-plugin-safe-dates",
  "version": "0.1.0",
  "description": "ESLint rules that prevent timezone bugs in JavaScript date handling",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "date",
    "timezone"
  ],
  "author": "Hariprasad M V",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepack": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.71.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript-eslint/rule-tester": "^8.71.1",
    "eslint": "^10.12.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
